{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hello_world",
  "version": "1.13.6",
  "identifier": "com.k2fsa.sherpa.onnx.hello.world",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "sherpa-onnx hello world",
        "width": 500,
        "height": 350
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "iOS": {
      "frameworks": [
        "sherpa-onnx.xcframework"
      ]
    }
  }
}
