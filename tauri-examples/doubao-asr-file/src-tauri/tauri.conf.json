{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "doubao-asr-file",
  "version": "1.13.8",
  "identifier": "com.k2fsa.sherpa.onnx.doubao.asr.file",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "录音文件识别 (Doubao ASR)",
        "width": 1000,
        "height": 760
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": ["assets"],
    "iOS": {
      "frameworks": ["sherpa-onnx.xcframework"]
    }
  }
}
