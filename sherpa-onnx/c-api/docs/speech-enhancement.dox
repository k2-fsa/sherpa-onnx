/**
@page speech_enhancement Speech Enhancement / Denoising

sherpa-onnx supports both offline and online speech enhancement with
three model families: GTCRN, DPDFNet and VoxLock.

@see SherpaOnnxCreateOfflineSpeechDenoiser, SherpaOnnxCreateOnlineSpeechDenoiser

@tableofcontents

@section se_offline_gtcrn Offline GTCRN

@code
SherpaOnnxOfflineSpeechDenoiserConfig config;
memset(&config, 0, sizeof(config));
config.model.gtcrn.model = "./gtcrn_simple.onnx";
config.model.num_threads = 1;
config.model.provider = "cpu";

const SherpaOnnxOfflineSpeechDenoiser *sd =
    SherpaOnnxCreateOfflineSpeechDenoiser(&config);

const SherpaOnnxDenoisedAudio *denoised =
    SherpaOnnxOfflineSpeechDenoiserRun(sd, wave->samples, wave->num_samples,
                                       wave->sample_rate);
SherpaOnnxWriteWave(denoised->samples, denoised->n, denoised->sample_rate,
                    "./clean.wav");
SherpaOnnxDestroyDenoisedAudio(denoised);
SherpaOnnxDestroyOfflineSpeechDenoiser(sd);
@endcode

Model file: `gtcrn_simple.onnx`

Example source: [speech-enhancement-gtcrn-c-api.c](https://github.com/k2-fsa/sherpa-onnx/blob/master/c-api-examples/speech-enhancement-gtcrn-c-api.c)

@section se_offline_dpdfnet Offline DPDFNet

@code
SherpaOnnxOfflineSpeechDenoiserConfig config;
memset(&config, 0, sizeof(config));
config.model.dpdfnet.model = "./dpdfnet_baseline.onnx";
config.model.dpdfnet.attenuation_limit_db = 12.0f;
config.model.num_threads = 1;
config.model.provider = "cpu";

const SherpaOnnxOfflineSpeechDenoiser *sd =
    SherpaOnnxCreateOfflineSpeechDenoiser(&config);
// ... use sd ...
SherpaOnnxDestroyOfflineSpeechDenoiser(sd);
@endcode

Model file: `dpdfnet_baseline.onnx` (also: `dpdfnet2.onnx`, `dpdfnet4.onnx`,
`dpdfnet8.onnx` for 16 kHz; `dpdfnet2_8khz.onnx`, `dpdfnet8_8khz.onnx` for
8 kHz; and `dpdfnet2_48khz_hr.onnx`, `dpdfnet8_48khz_hr.onnx` for 48 kHz)

Example source: [speech-enhancement-dpdfnet-c-api.c](https://github.com/k2-fsa/sherpa-onnx/blob/master/c-api-examples/speech-enhancement-dpdfnet-c-api.c)

@section se_offline_voxlock Offline VoxLock

VoxLock is a target-speaker voice isolation model: it keeps the voice of one
speaker (the caller) and removes the other voices. The model is from
https://github.com/arbazsiddiqui/voxlock

@code
SherpaOnnxOfflineSpeechDenoiserConfig config;
memset(&config, 0, sizeof(config));
config.model.voxlock.enroll_model = "./sherpa-onnx-voxlock-int8/enroll.onnx";
config.model.voxlock.chunk_model = "./sherpa-onnx-voxlock-int8/chunk_int8.onnx";
config.model.voxlock.voice_sample =
    "./sherpa-onnx-voxlock-int8/test_wavs/en-voice-sample-f.wav"; /* optional */
config.model.num_threads = 1;
config.model.provider = "cpu";

const SherpaOnnxOfflineSpeechDenoiser *sd =
    SherpaOnnxCreateOfflineSpeechDenoiser(&config);
// ... use sd ...
SherpaOnnxDestroyOfflineSpeechDenoiser(sd);
@endcode

Model files: `enroll.onnx` and `chunk.onnx` (or `chunk_int8.onnx`) from
https://github.com/k2-fsa/sherpa-onnx/releases/tag/speech-enhancement-models

`voice_sample` is optional: a wave file with at least 3 seconds of the
caller's voice. From a longer file, the loudest 3 seconds within its first 30
seconds are used; a file that is shorter or cannot be read is ignored. If it
is empty or ignored, the offline denoiser uses the loudest 3 seconds in the
first 15 seconds of the input, and the online denoiser passes the audio
through unchanged until 3 seconds of speech have been heard, then uses that
speech.

Example source: [speech-enhancement-voxlock-c-api.c](https://github.com/k2-fsa/sherpa-onnx/blob/master/c-api-examples/speech-enhancement-voxlock-c-api.c),
[speech-enhancement-voxlock-with-voice-sample-c-api.c](https://github.com/k2-fsa/sherpa-onnx/blob/master/c-api-examples/speech-enhancement-voxlock-with-voice-sample-c-api.c)

@section se_online_gtcrn Online GTCRN

@code
SherpaOnnxOnlineSpeechDenoiserConfig config;
memset(&config, 0, sizeof(config));
config.model.gtcrn.model = "./gtcrn_simple.onnx";
config.model.num_threads = 1;
config.model.provider = "cpu";

const SherpaOnnxOnlineSpeechDenoiser *sd =
    SherpaOnnxCreateOnlineSpeechDenoiser(&config);

int32_t frame_shift =
    SherpaOnnxOnlineSpeechDenoiserGetFrameShiftInSamples(sd);
// Feed audio in frame_shift chunks, then flush
const SherpaOnnxDenoisedAudio *out = SherpaOnnxOnlineSpeechDenoiserFlush(sd);
SherpaOnnxDestroyDenoisedAudio(out);
SherpaOnnxDestroyOnlineSpeechDenoiser(sd);
@endcode

Model file: `gtcrn_simple.onnx`

Example source: [online-speech-enhancement-gtcrn-c-api.c](https://github.com/k2-fsa/sherpa-onnx/blob/master/c-api-examples/online-speech-enhancement-gtcrn-c-api.c)

@section se_online_dpdfnet Online DPDFNet

@code
SherpaOnnxOnlineSpeechDenoiserConfig config;
memset(&config, 0, sizeof(config));
config.model.dpdfnet.model = "./dpdfnet_baseline.onnx";
config.model.num_threads = 1;
config.model.provider = "cpu";

const SherpaOnnxOnlineSpeechDenoiser *sd =
    SherpaOnnxCreateOnlineSpeechDenoiser(&config);
// ... use sd ...
SherpaOnnxDestroyOnlineSpeechDenoiser(sd);
@endcode

Model files: `dpdfnet_baseline.onnx`, `dpdfnet2.onnx`, `dpdfnet4.onnx`,
`dpdfnet8.onnx` for 16 kHz; `dpdfnet2_8khz.onnx`, `dpdfnet8_8khz.onnx` for
8 kHz; and `dpdfnet2_48khz_hr.onnx`, `dpdfnet8_48khz_hr.onnx` for 48 kHz.

Example source: [online-speech-enhancement-dpdfnet-c-api.c](https://github.com/k2-fsa/sherpa-onnx/blob/master/c-api-examples/online-speech-enhancement-dpdfnet-c-api.c)

@section se_online_voxlock Online VoxLock

@code
SherpaOnnxOnlineSpeechDenoiserConfig config;
memset(&config, 0, sizeof(config));
config.model.voxlock.enroll_model = "./sherpa-onnx-voxlock-int8/enroll.onnx";
config.model.voxlock.chunk_model = "./sherpa-onnx-voxlock-int8/chunk_int8.onnx";
config.model.num_threads = 1;
config.model.provider = "cpu";

const SherpaOnnxOnlineSpeechDenoiser *sd =
    SherpaOnnxCreateOnlineSpeechDenoiser(&config);
// ... feed audio in frame_shift chunks, then flush ...
SherpaOnnxDestroyOnlineSpeechDenoiser(sd);
@endcode

Model files: `enroll.onnx` and `chunk.onnx` (or `chunk_int8.onnx`); see
se_offline_voxlock for the optional `voice_sample` and for links to the
models.

Example source: [online-speech-enhancement-voxlock-c-api.c](https://github.com/k2-fsa/sherpa-onnx/blob/master/c-api-examples/online-speech-enhancement-voxlock-c-api.c),
[online-speech-enhancement-voxlock-with-voice-sample-c-api.c](https://github.com/k2-fsa/sherpa-onnx/blob/master/c-api-examples/online-speech-enhancement-voxlock-with-voice-sample-c-api.c)
*/
